# ==============================================================================
# Viam Machine Credentials
# ==============================================================================
# In Viam app -> Machine -> Code sample / Connect tab:
VIAM_API_KEY=your_viam_api_key_here
VIAM_API_KEY_ID=your_viam_api_key_id_here
VIAM_MACHINE_ADDRESS=sfhack12-main.ty1cywh7tq.viam.cloud

# Component names configured in Viam
VIAM_ARM_NAME=arm
VIAM_GRIPPER_NAME=gripper
VIAM_CAMERA_NAME=cam
VIAM_MOTION_NAME=builtin

# ==============================================================================
# MongoDB Atlas
# ==============================================================================
# Standard SRV connection string with Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=physical_ai_db

# ==============================================================================
# Execution Mode
# ==============================================================================
# Set to true for offline simulation with mock components (fake arm & gripper)
# Set to false when connecting to physical robot hardware
MOCK_MODE=true
